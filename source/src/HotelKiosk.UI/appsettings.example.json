{
  "CheckInStateMachine": {
    "MaxRetries": 3,
    "TimeoutSeconds": 30,
    "PaymentCheckTimeoutSeconds": 300,
    "PaymentPollIntervalSeconds": 3,
    "PaymentCheckRetries": 2,
    "CompensationRetries": 3
  },
  "LogusApi": {
    "BaseUrl": "http://192.168.99.9:8020/api",
    "Login": "YOUR_LOGUS_LOGIN",
    "Password": "YOUR_LOGUS_PASSWORD",
    "PropertyId": 1,
    "PaymentTransactionCode": "CASHLESS",
    "TimeoutSeconds": 15,
    "SendGuestDocuments": true,
    "DocumentTypeCode": "ПАСГРАРГ",
    "DocumentTypeName": "Паспорт гражданина Российской Федерации",
    "UseProxy": false,
    "ProxyUrl": "",
    "CancellationReasonCodes": {
      "Compensation": "Compensation",
      "GuestRequest": "GuestRequest",
      "SystemError": "SystemError",
      "Overbooking": "Overbooking"
    }
  },
  "Regula": {
    "DocumentReaderUrl": "http://localhost:8080/api",
    "Scenario": "FullProcess",
    "ProcessPath": "process",
    "HealthPath": "ping",
    "AgentScanPath": "",
    "LicenseKey": "",
    "DateFormat": "yyyy-MM-dd",
    "TimeoutSeconds": 30
  },
  "VisionLine": {
    "BaseUrl": "http://192.168.4.55:27015",
    "Token": "YOUR_VISIONLINE_TOKEN_OR_EMPTY",
    "IssuerId": "",
    "IssueKeyCardPath": "/IssueKeyCard",
    "ReadKeyCardPath": "/ReadKeyCard",
    "HealthPath": "/health",
    "TimeoutSeconds": 20,
    "HealthMonitorEnabled": false
  },
  "Telegram": {
    "Enabled": true,
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER",
    "ChatId": "YOUR_STAFF_GROUP_CHAT_ID"
  },
  "AlfaBankQr": {
    "TestMode": true,
    "TestBaseUrl": "https://test.payment.alfabank.ru/payment/rest/",
    "BaseUrl": "https://payment.alfabank.ru/payment/rest/",
    "Login": "YOUR_ALFABANK_LOGIN",
    "Password": "YOUR_ALFABANK_PASSWORD",
    "ReturnUrl": "https://kiosk.local/callback",
    "QrLifetimeMinutes": 5,
    "PollIntervalSeconds": 3,
    "RequestTimeoutSeconds": 15
  },
  "CardTerminal": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8090",
    "ChargePath": "/payment/charge",
    "StatusPath": "/payment/status",
    "RefundPath": "/payment/refund",
    "HealthPath": "/health",
    "TimeoutSeconds": 90,
    "PollIntervalSeconds": 3
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "MinimumLevelOverride": {
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kiosk-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
