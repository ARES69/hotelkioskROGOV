{
  "Pms": {
    "Provider": "logus",
    "DisplayName": "Logus"
  },

  "LogusApi": {
    "BaseUrl": "https://api-hms.logus.pro/api",
    "Login": "",
    "Password": "",
    "TimeoutSeconds": 15,
    "PropertyId": 1,
    "PaymentTransactionCode": "",
    "SendGuestDocuments": true,
    "DocumentTypeCode": "ПАСГРАРФ",
    "DocumentTypeName": "Паспорт гражданина Российской Федерации",
    "UseProxy": false,
    "ProxyUrl": "",
    "CancellationReasonCodes": {
      "Compensation": "Compensation",
      "GuestRequest": "GuestRequest",
      "SystemError": "SystemError",
      "Overbooking": "Overbooking"
    }
  },
  "Regula": {
    "DocumentReaderUrl": "http://localhost:8080/api",
    "Scenario": "FullProcess",
    "ProcessPath": "process",
    "HealthPath": "ping",
    "AgentScanPath": "",
    "CaptureSource": "camera",
    "CameraWidth": 1280,
    "CameraHeight": 960,
    "CameraJpegQuality": 0.9,
    "CameraCountdownSeconds": 3,
    "LicenseKey": "",
    "DateFormat": "yyyy-MM-dd",
    "TimeoutSeconds": 30
  },
  "VisionLine": {
    "BaseUrl": "http://192.168.4.55:27015",
    "Token": "",
    "IssuerId": "",
    "IssueKeyCardPath": "/IssueKeyCard",
    "ReadKeyCardPath": "/ReadKeyCard",
    "HealthPath": "/health",
    "TimeoutSeconds": 20,
    "HealthMonitorEnabled": false
  },
  "Telegram": {
    "Enabled": true,
    "BotToken": "",
    "ChatId": ""
  },
  "AlfaBankQr": {
    "TestMode": true,
    "TestBaseUrl": "https://test.payment.alfabank.ru/payment/rest/",
    "BaseUrl": "https://payment.alfabank.ru/payment/rest/",
    "Login": "",
    "Password": "",
    "ReturnUrl": "https://kiosk.local/callback",
    "QrLifetimeMinutes": 5,
    "PollIntervalSeconds": 3,
    "RequestTimeoutSeconds": 15
  },
  "CardTerminal": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8090",
    "ChargePath": "/payment/charge",
    "StatusPath": "/payment/status",
    "RefundPath": "/payment/refund",
    "HealthPath": "/health",
    "TimeoutSeconds": 90,
    "PollIntervalSeconds": 3
  },
  "CheckInStateMachine": {
    "MaxRetries": 3,
    "TimeoutSeconds": 30,
    "PaymentCheckTimeoutSeconds": 300,
    "PaymentPollIntervalSeconds": 3,
    "PaymentCheckRetries": 2,
    "CompensationRetries": 3
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kiosk-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
