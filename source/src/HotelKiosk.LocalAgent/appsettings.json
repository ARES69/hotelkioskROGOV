{
  "LogusApi": {
    "BaseUrl": "https://api-hms.logus.pro/api",
    "Login": "",
    "Password": "",
    "TimeoutSeconds": 15,
    "UseProxy": false,
    "ProxyUrl": "",
    "CancellationReasonCodes": {
      "Compensation": "Compensation",
      "GuestRequest": "GuestRequest",
      "SystemError": "SystemError",
      "Overbooking": "Overbooking"
    }
  },
  "Regula": {
    "DocumentReaderUrl": "http://localhost:8080/api",
    "Scenario": "FullProcess",
    "ProcessPath": "process",
    "HealthPath": "ping",
    "AgentScanPath": "",
    "LicenseKey": "",
    "DateFormat": "yyyy-MM-dd",
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/localagent-.log", "rollingInterval": "Day" } }
    ]
  }
}
